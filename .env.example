# Example environment file
OPENAI_API_KEY=your_api_key_here

# Model Configuration
DEFAULT_MODEL=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=2000

# Logging
LOG_LEVEL=INFO

# Git Bot Identity (używane przez GitAgent)
# Nazwa i email pojawią się w historii commitów na GitHubie.
# Aby commity były powiązane z kontem GitHub użyj noreply emaila konta bota:
#   GIT_BOT_EMAIL=ID+nazwa-konta@users.noreply.github.com
# ID konta znajdziesz na: https://api.github.com/users/<nazwa-konta>
GIT_BOT_NAME=agents-bot-github
GIT_BOT_EMAIL=https://github.com/user/pz-aiagent

# GitHub Personal Access Token konta bota
# Generuj na: https://github.com/settings/tokens
# Wymagane uprawnienia: Contents (read & write), Metadata (read)
# Token jest używany TYLKO przy push — nigdy nie pojawia się w logach ani commitach
GIT_BOT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
